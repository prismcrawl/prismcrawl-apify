{
    "$schema": "https://apify.com/schemas/v1/dataset.ide.json",
    "actorSpecification": 1,
    "fields": {
        "type": "object",
        "description": "One item per PrismCrawl page: the PrismCrawl response body unchanged, plus the Actor's page number and the X-Credits-Remaining header value.",
        "required": [
            "page",
            "success",
            "request_id",
            "data"
        ],
        "properties": {
            "page": {
                "type": "integer",
                "description": "1-based page number within this run."
            },
            "credits_remaining": {
                "type": [
                    "integer",
                    "null"
                ],
                "description": "PrismCrawl credits remaining after this request (X-Credits-Remaining header), or null if not returned."
            },
            "success": {
                "type": "boolean"
            },
            "request_id": {
                "type": "string",
                "description": "PrismCrawl request ID. Include it when contacting PrismCrawl support."
            },
            "data": {
                "type": "object",
                "description": "PrismCrawl response data: format and content (search_parameters, results, has_next_page, and endpoint-specific fields)."
            }
        }
    },
    "views": {
        "items": {
            "title": "Apps and products",
            "description": "One row per app, game, book, movie, or product.",
            "transformation": {
                "unwind": [
                    "data",
                    "content",
                    "results"
                ],
                "fields": [
                    "page",
                    "position",
                    "thumbnail",
                    "title",
                    "id",
                    "developer",
                    "category",
                    "rating",
                    "rating_count",
                    "price_text",
                    "installs",
                    "url",
                    "request_id",
                    "data"
                ]
            },
            "display": {
                "component": "table",
                "properties": {
                    "page": {
                        "label": "Page",
                        "format": "number"
                    },
                    "position": {
                        "label": "Position",
                        "format": "number"
                    },
                    "thumbnail": {
                        "label": "Icon",
                        "format": "image"
                    },
                    "title": {
                        "label": "Title",
                        "format": "text"
                    },
                    "id": {
                        "label": "ID",
                        "format": "text"
                    },
                    "developer": {
                        "label": "Developer",
                        "format": "text"
                    },
                    "category": {
                        "label": "Category",
                        "format": "text"
                    },
                    "rating": {
                        "label": "Rating",
                        "format": "number"
                    },
                    "rating_count": {
                        "label": "Ratings",
                        "format": "number"
                    },
                    "price_text": {
                        "label": "Price",
                        "format": "text"
                    },
                    "installs": {
                        "label": "Installs",
                        "format": "text"
                    },
                    "url": {
                        "label": "URL",
                        "format": "link"
                    },
                    "request_id": {
                        "label": "PrismCrawl request ID",
                        "format": "text"
                    }
                }
            }
        },
        "reviews": {
            "title": "Reviews",
            "description": "One row per review.",
            "transformation": {
                "unwind": [
                    "data",
                    "content",
                    "results"
                ],
                "fields": [
                    "page",
                    "position",
                    "rating",
                    "text",
                    "author",
                    "date",
                    "published_at",
                    "language",
                    "helpful_votes",
                    "url",
                    "request_id",
                    "data"
                ]
            },
            "display": {
                "component": "table",
                "properties": {
                    "page": {
                        "label": "Page",
                        "format": "number"
                    },
                    "position": {
                        "label": "Position",
                        "format": "number"
                    },
                    "rating": {
                        "label": "Rating",
                        "format": "number"
                    },
                    "text": {
                        "label": "Review",
                        "format": "text"
                    },
                    "author": {
                        "label": "Author",
                        "format": "text"
                    },
                    "date": {
                        "label": "Date",
                        "format": "text"
                    },
                    "published_at": {
                        "label": "Published",
                        "format": "text"
                    },
                    "language": {
                        "label": "Language",
                        "format": "text"
                    },
                    "helpful_votes": {
                        "label": "Helpful votes",
                        "format": "number"
                    },
                    "url": {
                        "label": "URL",
                        "format": "link"
                    },
                    "request_id": {
                        "label": "PrismCrawl request ID",
                        "format": "text"
                    }
                }
            }
        },
        "pages": {
            "title": "Pages",
            "description": "One row per PrismCrawl request, with the complete normalized response.",
            "transformation": {
                "fields": [
                    "page",
                    "request_id",
                    "success",
                    "credits_remaining",
                    "data"
                ]
            },
            "display": {
                "component": "table",
                "properties": {
                    "page": {
                        "label": "Page",
                        "format": "number"
                    },
                    "request_id": {
                        "label": "PrismCrawl request ID",
                        "format": "text"
                    },
                    "success": {
                        "label": "Success",
                        "format": "boolean"
                    },
                    "credits_remaining": {
                        "label": "Credits remaining",
                        "format": "number"
                    },
                    "data": {
                        "label": "Response data",
                        "format": "object"
                    }
                }
            }
        }
    }
}
