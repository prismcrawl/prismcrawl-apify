            "description": "Amazon-native result ordering. Leave empty for the default."
        },
        "category_id": {
            "title": "Category ID",
            "type": "string",
            "editor": "textfield",
            "description": "Amazon category or browse-node identifier.",
            "pattern": "^[A-Za-z0-9_-]+$",
            "maxLength": 40
        },
        "rh": {
            "title": "Refinements (rh)",
            "type": "string",
            "editor": "textfield",
            "description": "Comma-separated Amazon <code>key:value</code> refinements, as used in Amazon search URLs.",
            "pattern": "^[A-Za-z0-9_-]+:[A-Za-z0-9_-]+(?:,[A-Za-z0-9_-]+:[A-Za-z0-9_-]+)*$",
            "maxLength": 2000
        },
        "merchant_id": {
            "title": "Merchant ID",
            "type": "string",
            "editor": "textfield",
            "description": "Restrict results to one Amazon merchant (seller) ID.",
            "pattern": "^[A-Za-z0-9_-]+$",
            "maxLength": 64
        },
        "direct_search": {
            "title": "Direct category search",
            "type": "boolean",
            "default": false,
            "description": "Use Amazon's direct category-search mode."
        },
        "zero_trace": {
            "sectionCaption": "Privacy",
            "title": "Zero trace",
            "type": "boolean",
            "default": false,
            "description": "When enabled, PrismCrawl does not store the source or parsed response for these requests; only audit and billing metadata is kept. Results still appear in this Actor's dataset."
        }
    },
    "required": [
        "prismcrawlApiKey",
        "query"
    ]
}
