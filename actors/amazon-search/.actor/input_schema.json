{
    "$schema": "https://apify.com/schemas/v1/input.ide.json",
    "title": "PrismCrawl Amazon Search API input",
    "description": "Search Amazon marketplaces through the PrismCrawl API and get product results with prices, ratings, badges, and delivery info, plus filters, categories, and related searches. You need a PrismCrawl API key; each successful request uses one PrismCrawl credit, and failed requests are free.",
    "type": "object",
    "schemaVersion": 1,
    "properties": {
        "prismcrawlApiKey": {
            "title": "PrismCrawl API key",
            "type": "string",
            "editor": "textfield",
            "isSecret": true,
            "description": "Your PrismCrawl API key, sent to PrismCrawl as the <code>x-api-key</code> header. Create or rotate it in the <a href=\"https://www.prismcrawl.com/\" target=\"_blank\">PrismCrawl dashboard</a>; new accounts get 100 free credits. The key is stored encrypted by Apify and is never logged or written to the dataset."
        },
        "query": {
            "title": "Search query",
            "type": "string",
            "editor": "textfield",
            "description": "What to search for on Amazon. Limited to 8,192 UTF-8 bytes.",
            "prefill": "espresso machine"
        },
        "maxPages": {
            "title": "Maximum pages",
            "type": "integer",
            "editor": "number",
            "description": "How many pages to fetch (one Amazon results page each). The Actor stops early when PrismCrawl reports there is no next page. <strong>Each page is a separate PrismCrawl request and uses one credit.</strong>",
            "minimum": 1,
            "maximum": 20,
            "default": 1
        },
        "page": {
            "title": "First page",
            "type": "integer",
            "editor": "number",
            "description": "One-based Amazon results page to start from (1–1,000). Default 1.",
            "minimum": 1,
            "maximum": 1000
        },
