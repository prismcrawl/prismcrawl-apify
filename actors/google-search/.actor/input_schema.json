{
    "$schema": "https://apify.com/schemas/v1/input.ide.json",
    "title": "PrismCrawl Google Search API input",
    "description": "Run live Google searches through the PrismCrawl API and receive normalized search results, SERP features, and pagination metadata. You need a PrismCrawl API key; each successful request uses one PrismCrawl credit, and failed requests are free.",
    "type": "object",
    "schemaVersion": 1,
    "properties": {
        "prismcrawlApiKey": {
            "title": "PrismCrawl API key",
            "type": "string",
            "editor": "textfield",
            "isSecret": true,
            "description": "Your PrismCrawl API key, sent to PrismCrawl as the <code>x-api-key</code> header. Create or rotate it in the <a href=\"https://www.prismcrawl.com/\" target=\"_blank\">PrismCrawl dashboard</a>; new accounts get 100 free credits. The key is stored encrypted by Apify and is never logged or written to the dataset."
        },
        "query": {
            "title": "Search query",
            "type": "string",
            "editor": "textfield",
            "description": "What to search for on Google, exactly as you would type it into the search box. Search operators such as <code>site:</code> work as usual. Limited to 8,192 UTF-8 bytes.",
            "prefill": "best coffee shops in Baltimore"
        },
        "maxPages": {
            "title": "Maximum pages",
            "type": "integer",
            "editor": "number",
            "description": "How many pages to fetch (one Google results page each). The Actor stops early when PrismCrawl reports there is no next page. <strong>Each page is a separate PrismCrawl request and uses one credit.</strong>",
            "minimum": 1,
            "maximum": 10,
            "default": 1
        },
        "start": {
            "title": "Start offset",
            "type": "integer",
            "editor": "number",
            "description": "Zero-based result offset for the first page (for example <code>10</code> starts at the second page). Leave empty to start at the first result. Later pages advance the offset by 10.",
            "minimum": 0
        },
