        },
        "location": {
            "title": "Location",
            "type": "string",
            "editor": "textfield",
            "description": "Search as if from a named place, for example <code>Baltimore,Maryland,United States</code>. The value must be an active <em>Canonical Name</em> from <a href=\"https://developers.google.com/google-ads/api/data/geotargets\" target=\"_blank\">Google's geo-target list</a>. Cannot be combined with coordinates or UULE."
        },
        "latitude": {
            "title": "Latitude",
            "type": "number",
            "editor": "number",
            "description": "Searcher latitude, for example <code>39.2904</code>. Set together with longitude. Cannot be combined with location or UULE.",
            "minimum": -90,
            "maximum": 90
        },
        "longitude": {
            "title": "Longitude",
            "type": "number",
            "editor": "number",
            "description": "Searcher longitude, for example <code>-76.6122</code>. Set together with latitude.",
            "minimum": -180,
            "maximum": 180
        },
        "radius": {
            "title": "Radius (meters)",
            "type": "integer",
            "editor": "number",
            "description": "Bias results to within this many meters of the coordinates; results outside it may still appear. Requires latitude and longitude. Maximum 199 for desktop or no device, 1,000 for mobile or tablet.",
            "minimum": 1,
            "maximum": 1000
        },
        "device": {
            "title": "Device",
            "type": "string",
            "editor": "select",
            "enum": [
                "mobile",
                "tablet",
                "desktop"
            ],
            "enumTitles": [
                "Mobile",
                "Tablet",
                "Desktop"
            ],
            "description": "Search as a desktop, mobile, or tablet device. Rankings and SERP features can differ by device. Leave empty for PrismCrawl's default."
        },
        "tbm": {
            "sectionCaption": "Search type and filters",
            "sectionDescription": "Choose a Google search tab and narrow the results. Use either a tbm vertical or a udm tab, not both.",
            "title": "Search vertical (tbm)",
            "type": "string",
            "editor": "select",
            "enum": [
                "nws",
                "vid",
                "isch",
                "shop",
                "lcl",
                "bks"
            ],
            "enumTitles": [
                "News (nws)",
                "Videos (vid)",
                "Images (isch)",
                "Shopping (shop)",
                "Local (lcl)",
                "Books (bks)"
            ],
            "description": "Search a Google vertical instead of the regular results page. Leave empty for regular web results. Cannot be combined with <strong>Search tab (udm)</strong>."
        },
        "udm": {
            "title": "Search tab (udm)",
            "type": "string",
            "editor": "select",
            "enum": [
                "1",
                "2",
                "6",
                "7",
                "12",
                "14",
                "28",
                "36",
                "50"
            ],
            "enumTitles": [
                "Local (1)",
                "Images (2)",
                "Forums (6)",
                "Videos (7)",
                "News (12)",
                "Web (14)",
                "Shopping (28)",
                "Books (36)",
                "AI Mode (50)"
            ],
            "description": "Select a Google search tab by its numeric <code>udm</code> value, for example <em>Web</em> (links only) or <em>AI Mode</em>. Availability varies by market. Cannot be combined with <strong>Search vertical (tbm)</strong>."
        },
        "tbs": {
            "title": "Time and advanced filters (tbs)",
            "type": "string",
            "editor": "textfield",
            "description": "Google's native advanced-filter string. Common time filters: <code>qdr:h</code> (past hour), <code>qdr:d</code> (past day), <code>qdr:w</code> (past week), <code>qdr:m</code> (past month), <code>qdr:y</code> (past year); add a number for multiples, e.g. <code>qdr:m6</code>. Custom range: <code>cdr:1,cd_min:8/1/2026,cd_max:8/12/2026</code>. Sort by date (News): <code>sbd:1</code>. Supported filters vary by vertical and market.",
            "maxLength": 512
        },
        "safe": {
            "title": "SafeSearch",
            "type": "string",
            "editor": "select",
            "enum": [
                "active",
                "off"
            ],
            "enumTitles": [
                "On (active)",
                "Off"
            ],
            "description": "Turn Google's SafeSearch filtering on or request unfiltered results. Leave empty for Google's default."
        },
        "lr": {
            "sectionCaption": "Advanced Google controls",
            "sectionDescription": "Rarely needed. Leave empty to use Google's defaults.",
            "title": "Restrict to languages (lr)",
            "type": "string",
            "editor": "textfield",
            "description": "Only return documents in these languages, using <code>lang_&lt;code&gt;</code> syntax. Separate alternatives with <code>|</code>, e.g. <code>lang_fr|lang_de</code>.",
            "pattern": "^lang_[a-z]{2,3}(\\|lang_[a-z]{2,3})*$"
        },
        "cr": {
            "title": "Restrict to countries (cr)",
            "type": "string",
            "editor": "textfield",
            "description": "Only return documents from these countries, using <code>country&lt;CC&gt;</code> syntax. Separate alternatives with <code>|</code>, e.g. <code>countryUS|countryCA</code>.",
            "pattern": "^country[A-Za-z]{2}(\\|country[A-Za-z]{2})*$"
        },
        "uule": {
            "title": "Encoded location (uule)",
            "type": "string",
            "editor": "textfield",
            "description": "A raw Google-encoded location (starting with <code>w+</code> or <code>a+</code>), forwarded unchanged. Google may ignore unsupported values. Prefer <strong>Location</strong> unless you already have UULE strings. Cannot be combined with location or coordinates.",
            "pattern": "^[wa]\\+(?:[A-Za-z0-9+/]+|[A-Za-z0-9_-]+)={0,2}$"
        },
        "nfpr": {
            "title": "Spelling correction (nfpr)",
            "type": "string",
            "editor": "select",
            "enum": [
                "1",
                "0"
            ],
            "enumTitles": [
                "Search the exact query, no auto-correction (1)",
                "Normal correction (0)"
            ],
            "description": "Whether Google may automatically correct the spelling of your query."
        },
        "filter": {
            "title": "Duplicate filtering (filter)",
            "type": "string",
            "editor": "select",
            "enum": [
                "1",
                "0"
            ],
            "enumTitles": [
                "Filter duplicates (1)",
                "Show duplicates (0)"
            ],
            "description": "Request Google's duplicate-result filtering on or off. Google does not guarantee this for regular search pages."
        },
        "pws": {
            "title": "Personalization (pws)",
            "type": "string",
            "editor": "select",
            "enum": [
                "0",
                "1"
            ],
            "enumTitles": [
                "Request personalization off (0)",
                "Permit personalization (1)"
            ],
            "description": "Ask Google to turn personalization off or permit it. This does not disable location, language, or device effects."
        },
        "zero_trace": {
            "sectionCaption": "Privacy",
            "title": "Zero trace",
            "type": "boolean",
            "default": false,
            "description": "When enabled, PrismCrawl does not store the source or parsed response for these requests; only audit and billing metadata is kept. Results still appear in this Actor's dataset."
        }
    },
    "required": [
        "prismcrawlApiKey",
        "query"
    ]
}
