{
    "$schema": "https://apify.com/schemas/v1/dataset.ide.json",
    "actorSpecification": 1,
    "fields": {
        "type": "object",
        "description": "One item per PrismCrawl page: the PrismCrawl response body unchanged, plus the Actor's page number and the X-Credits-Remaining header value.",
        "required": [
            "page",
            "success",
            "request_id",
            "data"
        ],
        "properties": {
            "page": {
                "type": "integer",
                "description": "1-based page number within this run."
            },
            "credits_remaining": {
                "type": [
                    "integer",
                    "null"
                ],
                "description": "PrismCrawl credits remaining after this request (X-Credits-Remaining header), or null if not returned."
            },
            "success": {
                "type": "boolean"
            },
            "request_id": {
                "type": "string",
                "description": "PrismCrawl request ID. Include it when contacting PrismCrawl support."
            },
            "data": {
                "type": "object",
                "description": "PrismCrawl response data: format and content (search_parameters, results, has_next_page, and endpoint-specific fields)."
            }
        }
    },
    "views": {
        "items": {
            "title": "Products and offers",
            "description": "One row per product or seller offer.",
            "transformation": {
                "unwind": [
                    "data",
                    "content",
                    "results"
                ],
                "fields": [
                    "page",
                    "position",
                    "thumbnail",
                    "title",
                    "id",
                    "price",
                    "currency",
                    "rating",
                    "review_count",
                    "seller",
                    "seller_name",
                    "availability",
                    "url",
                    "request_id"
                ]
            },
            "display": {
                "component": "table",
                "properties": {
                    "page": {
                        "label": "Page",
                        "format": "number"
                    },
                    "position": {
                        "label": "Position",
                        "format": "number"
                    },
                    "thumbnail": {
                        "label": "Image",
                        "format": "image"
                    },
                    "title": {
                        "label": "Title",
                        "format": "text"
                    },
                    "id": {
                        "label": "ID",
                        "format": "text"
                    },
                    "price": {
                        "label": "Price",
                        "format": "number"
                    },
                    "currency": {
                        "label": "Currency",
                        "format": "text"
                    },
                    "rating": {
                        "label": "Rating",
                        "format": "number"
                    },
                    "review_count": {
                        "label": "Reviews",
                        "format": "number"
                    },
                    "seller": {
                        "label": "Seller",
                        "format": "text"
                    },
                    "seller_name": {
                        "label": "Seller name",
                        "format": "text"
                    },
                    "availability": {
                        "label": "Availability",
                        "format": "text"
                    },
                    "url": {
                        "label": "URL",
                        "format": "link"
                    },
                    "request_id": {
                        "label": "PrismCrawl request ID",
                        "format": "text"
                    }
                }
            }
        },
        "pages": {
            "title": "Pages",
            "description": "One row per PrismCrawl request, with the complete normalized response.",
            "transformation": {
                "fields": [
                    "page",
                    "request_id",
                    "success",
                    "credits_remaining",
                    "data"
                ]
            },
            "display": {
                "component": "table",
                "properties": {
                    "page": {
                        "label": "Page",
                        "format": "number"
                    },
                    "request_id": {
                        "label": "PrismCrawl request ID",
                        "format": "text"
                    },
                    "success": {
                        "label": "Success",
                        "format": "boolean"
                    },
                    "credits_remaining": {
                        "label": "Credits remaining",
                        "format": "number"
                    },
                    "data": {
                        "label": "Response data",
                        "format": "object"
                    }
                }
            }
        }
    }
}
