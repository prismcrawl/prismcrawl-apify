        "type": {
            "title": "Seller inventory",
            "type": "string",
            "editor": "select",
            "enum": [
                "user",
                "store"
            ],
            "enumTitles": [
                "User listings",
                "Store listings"
            ],
            "description": "For sellers: list the seller's user or store inventory. Leave empty for the profile only."
        },
        "limit": {
            "title": "Items per page",
            "type": "integer",
            "editor": "number",
            "description": "For seller inventory: maximum listings per page (1–100).",
            "minimum": 1,
            "maximum": 100
        },
        "maxPages": {
            "title": "Maximum pages",
            "type": "integer",
            "editor": "number",
            "description": "How many pages to fetch (search and seller inventory only). The Actor stops early when PrismCrawl reports there is no next page. <strong>Each page is a separate PrismCrawl request and uses one credit.</strong>",
            "minimum": 1,
            "maximum": 100,
            "default": 1
        },
