{
    "$schema": "https://apify.com/schemas/v1/input.ide.json",
    "title": "PrismCrawl eBay API input",
    "description": "Search eBay listings, get item details, and look up sellers and their inventory through the PrismCrawl API as structured JSON. You need a PrismCrawl API key; each successful request uses one PrismCrawl credit, and failed requests are free.",
    "type": "object",
    "schemaVersion": 1,
    "properties": {
        "prismcrawlApiKey": {
            "title": "PrismCrawl API key",
            "type": "string",
            "editor": "textfield",
            "isSecret": true,
            "description": "Your PrismCrawl API key, sent to PrismCrawl as the <code>x-api-key</code> header. Create or rotate it in the <a href=\"https://www.prismcrawl.com/\" target=\"_blank\">PrismCrawl dashboard</a>; new accounts get 100 free credits. The key is stored encrypted by Apify and is never logged or written to the dataset."
        },
        "mode": {
            "title": "What to fetch",
            "type": "string",
            "editor": "select",
            "enum": [
                "search",
                "product",
                "seller"
            ],
            "enumTitles": [
                "Search listings",
                "Item details",
                "Seller"
            ],
            "description": "Choose what to fetch. Search uses <strong>Search query</strong>; item details and sellers use <strong>Item or seller ID</strong>.",
            "default": "search"
        },
        "query": {
            "title": "Search query",
            "type": "string",
            "editor": "textfield",
            "description": "For search: text to search eBay for.",
            "prefill": "vintage camera"
        },
        "category_id": {
            "title": "Category ID",
            "type": "string",
            "editor": "textfield",
            "description": "For search: a numeric eBay category ID. Can replace the query."
        },
        "buying_format": {
            "title": "Buying format",
            "type": "string",
            "editor": "select",
            "enum": [
                "Auction",
                "BIN",
                "BO"
            ],
            "enumTitles": [
                "Auction",
                "Buy It Now",
                "Best Offer"
            ],
            "description": "For search: auctions, Buy It Now, or Best Offer."
        },
        "_udlo": {
            "title": "Minimum price",
            "type": "number",
            "editor": "number",
            "description": "For search.",
            "minimum": 0
        },
        "_udhi": {
            "title": "Maximum price",
            "type": "number",
            "editor": "number",
            "description": "For search.",
            "minimum": 0
        },
        "show_only": {
            "title": "Listing filters",
            "type": "string",
            "editor": "textfield",
            "description": "For search: comma-separated eBay filters, such as free shipping or free returns."
        },
        "LH_ItemCondition": {
            "title": "Item condition IDs",
            "type": "string",
            "editor": "textfield",
            "description": "For search: pipe-separated eBay condition IDs, such as <code>1000|3000</code>."
        },
        "_stpos": {
            "title": "Postal code",
            "type": "string",
            "editor": "textfield",
            "description": "For search: ZIP or postal code for delivery and distance filters."
        },
        "id": {
            "title": "Item or seller ID",
            "type": "string",
            "editor": "textfield",
            "description": "For item details: the item ID. For sellers: the public username."
        },
