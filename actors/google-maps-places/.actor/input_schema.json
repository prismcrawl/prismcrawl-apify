{
    "$schema": "https://apify.com/schemas/v1/input.ide.json",
    "title": "PrismCrawl Google Maps Places API input",
    "description": "Search Google Maps places around any coordinates through the PrismCrawl API: names, ratings, reviews count, addresses, phones, websites, hours, and more as structured JSON. You need a PrismCrawl API key; each successful request uses one PrismCrawl credit, and failed requests are free.",
    "type": "object",
    "schemaVersion": 1,
    "properties": {
        "prismcrawlApiKey": {
            "title": "PrismCrawl API key",
            "type": "string",
            "editor": "textfield",
            "isSecret": true,
            "description": "Your PrismCrawl API key, sent to PrismCrawl as the <code>x-api-key</code> header. Create or rotate it in the <a href=\"https://www.prismcrawl.com/\" target=\"_blank\">PrismCrawl dashboard</a>; new accounts get 100 free credits. The key is stored encrypted by Apify and is never logged or written to the dataset."
        },
        "query": {
            "title": "Search query",
            "type": "string",
            "editor": "textfield",
            "description": "A place, business, product, or category to search on Google Maps, such as <code>coffee shops</code> or <code>dentist</code>.",
            "prefill": "coffee shops"
        },
        "latitude": {
            "title": "Map center latitude",
            "type": "number",
            "editor": "number",
            "description": "Latitude of the map center, for example <code>39.2904</code>.",
            "minimum": -90,
            "maximum": 90,
            "prefill": 39.2904
        },
        "longitude": {
            "title": "Map center longitude",
            "type": "number",
            "editor": "number",
            "description": "Longitude of the map center, for example <code>-76.6122</code>.",
            "minimum": -180,
            "maximum": 180,
            "prefill": -76.6122
        },
        "zoom": {
            "title": "Zoom",
            "type": "number",
            "editor": "number",
            "description": "Google Maps viewport zoom, from 3 to 21. Lower values cover a wider area; higher values focus more tightly around the center. PrismCrawl defaults to 13.1.",
            "minimum": 3,
            "maximum": 30
        },
        "maxPages": {
            "title": "Maximum pages",
            "type": "integer",
            "editor": "number",
            "description": "How many pages to fetch (up to 20 places each). The Actor stops early when PrismCrawl reports there is no next page. <strong>Each page is a separate PrismCrawl request and uses one credit.</strong>",
            "minimum": 1,
            "maximum": 10,
            "default": 1
        },
        "start": {
            "title": "Start offset",
            "type": "integer",
            "editor": "number",
            "description": "Zero-based offset of the first place, in multiples of 20 (for example <code>20</code> starts at the second page). Leave empty to start at the first place.",
            "minimum": 0
        },
