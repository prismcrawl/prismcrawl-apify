{
    "$schema": "https://apify.com/schemas/v1/dataset.ide.json",
    "actorSpecification": 1,
    "fields": {
        "type": "object",
        "description": "One item per PrismCrawl page: the PrismCrawl response body unchanged, plus the Actor's page number and the X-Credits-Remaining header value.",
        "required": [
            "page",
            "success",
            "request_id",
            "data"
        ],
        "properties": {
            "page": {
                "type": "integer",
                "description": "1-based page number within this run."
            },
            "credits_remaining": {
                "type": [
                    "integer",
                    "null"
                ],
                "description": "PrismCrawl credits remaining after this request (X-Credits-Remaining header), or null if not returned."
            },
            "success": {
                "type": "boolean"
            },
            "request_id": {
                "type": "string",
                "description": "PrismCrawl request ID. Include it when contacting PrismCrawl support."
            },
            "data": {
                "type": "object",
                "description": "PrismCrawl response data: format and content (search_parameters, results, has_next_page, and endpoint-specific fields)."
            }
        }
    },
    "views": {
        "places": {
            "title": "Places",
            "description": "One row per place.",
            "transformation": {
                "unwind": [
                    "data",
                    "content",
                    "results"
                ],
                "fields": [
                    "page",
                    "rank",
                    "thumbnail",
                    "title",
                    "category",
                    "rating",
                    "reviews",
                    "price",
                    "address",
                    "phone",
                    "website",
                    "open_state",
                    "google_maps_url",
                    "place_id",
                    "request_id"
                ]
            },
            "display": {
                "component": "table",
                "properties": {
                    "page": {
                        "label": "Page",
                        "format": "number"
                    },
                    "rank": {
                        "label": "Rank",
                        "format": "number"
                    },
                    "thumbnail": {
                        "label": "Photo",
                        "format": "image"
                    },
                    "title": {
                        "label": "Name",
                        "format": "text"
                    },
                    "category": {
                        "label": "Category",
                        "format": "text"
                    },
                    "rating": {
                        "label": "Rating",
                        "format": "number"
                    },
                    "reviews": {
                        "label": "Reviews",
                        "format": "number"
                    },
                    "price": {
                        "label": "Price",
                        "format": "text"
                    },
                    "address": {
                        "label": "Address",
                        "format": "text"
                    },
                    "phone": {
                        "label": "Phone",
                        "format": "text"
                    },
                    "website": {
                        "label": "Website",
                        "format": "link"
                    },
                    "open_state": {
                        "label": "Open state",
                        "format": "text"
                    },
                    "google_maps_url": {
                        "label": "Google Maps",
                        "format": "link"
                    },
                    "place_id": {
                        "label": "Place ID",
                        "format": "text"
                    },
                    "request_id": {
                        "label": "PrismCrawl request ID",
                        "format": "text"
                    }
                }
            }
        },
        "pages": {
            "title": "Pages",
            "description": "One row per PrismCrawl request, with the complete normalized response.",
            "transformation": {
                "fields": [
                    "page",
                    "request_id",
                    "success",
                    "credits_remaining",
                    "data"
                ]
            },
            "display": {
                "component": "table",
                "properties": {
                    "page": {
                        "label": "Page",
                        "format": "number"
                    },
                    "request_id": {
                        "label": "PrismCrawl request ID",
                        "format": "text"
                    },
                    "success": {
                        "label": "Success",
                        "format": "boolean"
                    },
                    "credits_remaining": {
                        "label": "Credits remaining",
                        "format": "number"
                    },
                    "data": {
                        "label": "Response data",
                        "format": "object"
                    }
                }
            }
        }
    }
}
